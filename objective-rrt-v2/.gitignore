# Build output (cargo's default dir, and per-experiment snapshot builds)
/target/
/builds/
/target-*
# Search runs: replays, trees, diagnostics (large, regenerated per run)
/runs/
# Run logs (one per run, named after it)
/logs/
/runs-*.log
# Python caches from tools/
__pycache__/
# Reference material fetched from the web
/ref/
